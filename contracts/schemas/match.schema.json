{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match.schema.json",
  "title": "Pulse Match v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "period", "startMs", "endMs", "pitch", "teams", "players"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "startMs": { "type": "integer", "minimum": 0 },
    "endMs": { "type": "integer", "minimum": 1 },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lengthM", "widthM"],
      "properties": {
        "lengthM": { "const": 105 },
        "widthM": { "const": 68 }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "attackingDirection"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "attackingDirection": { "enum": ["LEFT", "RIGHT"] }
        }
      }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "teamId", "name", "number"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "teamId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "name": { "type": "string", "minLength": 1 },
          "number": { "type": "integer", "minimum": 1, "maximum": 99 }
        }
      }
    }
  }
}
