{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "match.schema.json",
  "title": "Pulse Match v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "period", "start_ms", "end_ms", "pitch", "teams", "players"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 1 },
    "pitch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length_m", "width_m"],
      "properties": {
        "length_m": { "type": "number", "exclusiveMinimum": 0 },
        "width_m": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "teams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "attacking_direction"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "attacking_direction": { "enum": ["left", "right"] }
        }
      }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "team_id", "name", "number"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "team_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "number": { "type": "integer", "minimum": 1, "maximum": 99 }
        }
      }
    }
  }
}
