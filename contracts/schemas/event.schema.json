{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Pulse Event v2",
  "allOf": [{ "if": { "properties": { "type": { "const": "PASS" }, "outcome": { "const": "COMPLETE" } }, "required": ["type", "outcome"] }, "then": { "required": ["recipientId"] } }],
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "matchId", "phaseId", "period", "timeMs", "type", "teamId", "actorId", "from", "to", "outcome"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "phaseId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "timeMs": { "type": "integer", "minimum": 0 },
    "type": { "enum": ["PASS", "CARRY", "CROSS", "CLEARANCE", "CORNER", "SHOT"] },
    "teamId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "actorId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "recipientId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "from": { "$ref": "#/$defs/point" },
    "to": { "$ref": "#/$defs/point" },
    "outcome": { "enum": ["COMPLETE", "INCOMPLETE", "BLOCKED"] }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    }
  }
}
