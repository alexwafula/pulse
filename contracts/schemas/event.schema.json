{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Pulse Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "match_id", "phase_id", "period", "time_ms", "type", "team_id", "actor_id", "from", "to", "outcome"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "match_id": { "type": "string", "minLength": 1 },
    "phase_id": { "type": "string", "minLength": 1 },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "time_ms": { "type": "integer", "minimum": 0 },
    "type": { "enum": ["pass", "carry", "cross", "clearance", "corner", "shot"] },
    "team_id": { "type": "string", "minLength": 1 },
    "actor_id": { "type": "string", "minLength": 1 },
    "recipient_id": { "type": "string", "minLength": 1 },
    "from": { "$ref": "#/$defs/point" },
    "to": { "$ref": "#/$defs/point" },
    "outcome": { "enum": ["complete", "incomplete", "blocked"] }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 }
      }
    }
  }
}
