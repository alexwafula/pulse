{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay-message.schema.json",
  "title": "Pulse Replay Stream Message v2",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "matchId", "timeMs", "match"],
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "kind": { "const": "MATCH" },
        "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "match": { "$ref": "match.schema.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "matchId", "timeMs", "tracking"],
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "kind": { "const": "TRACKING" },
        "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "tracking": { "$ref": "tracking.schema.json" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "matchId", "timeMs", "event"],
      "properties": {
        "schemaVersion": { "const": "2.0.0" },
        "kind": { "const": "EVENT" },
        "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "timeMs": { "type": "integer", "minimum": 0 },
        "event": { "$ref": "event.schema.json" }
      }
    }
  ]
}
