{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-pack.schema.json",
  "title": "Pulse Fact Pack v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "matchId", "period", "windowStartMs", "windowEndMs", "facts"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "windowStartMs": { "type": "integer", "minimum": 0 },
    "windowEndMs": { "type": "integer", "minimum": 0 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "value", "unit", "teamId", "timeStartMs", "timeEndMs", "eventIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "metric": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string", "minLength": 1 },
          "teamId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "timeStartMs": { "type": "integer", "minimum": 0 },
          "timeEndMs": { "type": "integer", "minimum": 0 },
          "eventIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    }
  }
}
