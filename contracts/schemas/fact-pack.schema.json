{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fact-pack.schema.json",
  "title": "Pulse Fact Pack v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "match_id", "period", "window_start_ms", "window_end_ms", "facts"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "match_id": { "type": "string", "minLength": 1 },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "window_start_ms": { "type": "integer", "minimum": 0 },
    "window_end_ms": { "type": "integer", "minimum": 0 },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "metric", "value", "unit", "team_id", "time_start_ms", "time_end_ms", "event_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "metric": { "type": "string", "minLength": 1 },
          "value": { "type": ["number", "string"] },
          "unit": { "type": "string", "minLength": 1 },
          "team_id": { "type": "string", "minLength": 1 },
          "time_start_ms": { "type": "integer", "minimum": 0 },
          "time_end_ms": { "type": "integer", "minimum": 0 },
          "event_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "attributes": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "boolean"] }
          }
        }
      }
    }
  }
}
