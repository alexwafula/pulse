{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlay-cue.schema.json",
  "title": "Pulse Overlay Cue v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "matchId", "period", "startMs", "endMs", "replayStartMs", "replayEndMs", "locale", "persona", "kind", "verification", "priority", "text", "factIds", "eventIds"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "startMs": { "type": "integer", "minimum": 0 },
    "endMs": { "type": "integer", "minimum": 0 },
    "replayStartMs": { "type": "integer", "minimum": 0 },
    "replayEndMs": { "type": "integer", "minimum": 0 },
    "locale": { "enum": ["en-GB", "sw-KE"] },
    "persona": { "enum": ["CASUAL", "ANALYST"] },
    "kind": { "const": "COMMENTARY" },
    "verification": { "allOf": [{ "$ref": "verification-result.schema.json" }, { "properties": { "status": { "enum": ["VERIFIED", "FALLBACK_TEMPLATE"] } } }] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 10 },
    "text": { "type": "string", "minLength": 1, "maxLength": 240 },
    "factIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "eventIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
