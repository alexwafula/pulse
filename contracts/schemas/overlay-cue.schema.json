{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "overlay-cue.schema.json",
  "title": "Pulse Overlay Cue v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "match_id", "period", "start_ms", "end_ms", "replay_start_ms", "replay_end_ms", "locale", "audience", "priority", "text", "fact_ids", "event_ids"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "match_id": { "type": "string", "minLength": 1 },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 0 },
    "replay_start_ms": { "type": "integer", "minimum": 0 },
    "replay_end_ms": { "type": "integer", "minimum": 0 },
    "locale": { "enum": ["en", "sw"] },
    "audience": { "enum": ["casual", "analyst"] },
    "priority": { "type": "integer", "minimum": 0, "maximum": 10 },
    "text": { "type": "string", "minLength": 1 },
    "fact_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "event_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
