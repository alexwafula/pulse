{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracking.schema.json",
  "title": "Pulse Tracking Frame v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "match_id", "period", "time_ms", "ball", "players"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "match_id": { "type": "string", "minLength": 1 },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "time_ms": { "type": "integer", "minimum": 0 },
    "ball": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "z": { "type": "number", "minimum": 0 }
      }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["player_id", "x", "y"],
        "properties": {
          "player_id": { "type": "string", "minLength": 1 },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
