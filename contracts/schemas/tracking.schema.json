{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tracking.schema.json",
  "title": "Pulse Tracking Frame v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "matchId", "period", "timeMs", "ball", "players"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "matchId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "period": { "type": "integer", "minimum": 1, "maximum": 4 },
    "timeMs": { "type": "integer", "minimum": 0 },
    "ball": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "z": { "type": "number", "minimum": 0 }
      }
    },
    "players": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["playerId", "x", "y"],
        "properties": {
          "playerId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
          "x": { "type": "number", "minimum": 0 },
          "y": { "type": "number", "minimum": 0 }
        }
      }
    }
  }
}
