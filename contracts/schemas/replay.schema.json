{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay.schema.json",
  "title": "Pulse Replay Fixture v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "match", "events", "tracking"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "match": { "$ref": "match.schema.json" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "event.schema.json" }
    },
    "tracking": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "tracking.schema.json" }
    }
  }
}
