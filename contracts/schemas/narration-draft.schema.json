{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narration-draft.schema.json",
  "title": "Pulse Narration Draft v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "factPackId", "locale", "persona", "text", "claims"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "factPackId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
    "locale": { "enum": ["en-GB", "sw-KE"] },
    "persona": { "enum": ["CASUAL", "ANALYST"] },
    "text": { "type": "string", "minLength": 1, "maxLength": 240 },
    "claims": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claim" } }
  },
  "$defs": {
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "factIds", "eventIds"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "factIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" } },
        "eventIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$" } }
      }
    }
  }
}
