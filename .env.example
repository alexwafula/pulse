# Never commit credentials.
# Optional Python service base URL. Empty uses the checked Go template.
PULSE_AGENTS_URL=http://127.0.0.1:8090
# Template is the zero-cost default. Shadow mode logs agent checks but still
# returns templates. Use a model resource endpoint, never a project endpoint.
PULSE_AGENT_MODE=template
PULSE_FOUNDRY_ENDPOINT=
PULSE_FOUNDRY_DEPLOYMENT=
PULSE_FOUNDRY_API_KEY=
# Maximum distinct shadow workflows per service process, not per role.
PULSE_MODEL_REQUEST_CAP=10
