# Never commit credentials.
# Optional Python service base URL. Empty uses the checked Go template.
PULSE_AGENTS_URL=http://127.0.0.1:8090
# Optional locally; required in Azure. Share a generated 64-character hex token
# only between Go/Python. Never send it to the browser or commit its value.
PULSE_AGENT_AUTH_TOKEN=
PULSE_REQUIRE_AUTH=0
# Template makes no paid model calls. foundry-shadow remains template-only.
# foundry publishes only independently checked, approved corner-shot wording.
# recorded serves the reviewed Foundry recording with no model calls or key.
# Use a model resource endpoint, never a project endpoint.
PULSE_AGENT_MODE=template
PULSE_FOUNDRY_ENDPOINT=
PULSE_FOUNDRY_DEPLOYMENT=
PULSE_FOUNDRY_API_KEY=
# Maximum distinct model workflows per service process, not per role.
PULSE_MODEL_REQUEST_CAP=0
